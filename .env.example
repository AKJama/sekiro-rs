# Copy this file to .env (which is gitignored) and fill in what you use.
# Nothing here is needed to play: the baseline game and the boss brain's Codex coach work without it.

# Optional: an OpenAI API key (billed per use) for the boss brain's fast in-fight
# --checkpoint decisions (OpenAI Decisions, model gpt-6-luna), and --coach api only.
# The default --checkpoint local is free and needs no API key.
# Without it everything else works, including the coach and local checkpoints.
OPENAI_API_KEY=
