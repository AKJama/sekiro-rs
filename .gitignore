# Whitelist: only original source and documentation may be tracked.
# Game data, extracted assets, decompiled output and analysis databases never enter git.
*
!/.gitignore
!/.env.example
!/AGENTS.md
!/README.md
!/STATUS.md
!/CREDITS.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/rustfmt.toml
!/config/
!/config/*.toml
!/docs/
!/docs/**/
!/docs/**/*.md
!/crates/
!/crates/**/
!/crates/**/Cargo.toml
!/crates/**/*.rs
!/crates/**/*.wgsl
!/crates/**/scripts/*.txt
!/crates/game/scripts/fxr_capture.ps1
!/crates/game/tests/data/*.json
!/tools/
!/tools/**/
!/tools/**/*.ps1
!/tools/**/*.py
!/tools/**/*.java
!/tools/**/pyproject.toml
!/tools/**/uv.lock

!/tools/reference_index/README.md
